{
  "name": "willstechstore-backend",
  "version": "1.0.0",
  "description": "Node.js + PostgreSQL (Neon) backend for Will's Tech Store (API + static storefront server)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "setup": "node src/migrate.js && node src/seed.js",
    "prepare-db": "node scripts/prepare.js",
    "env": "node scripts/setup-env.js",
    "start:fresh": "node scripts/setup-env.js && node scripts/prepare.js && node server.js",
    "seed:force": "node src/seed.js --force"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "sharp": "^0.35.5"
  }
}
