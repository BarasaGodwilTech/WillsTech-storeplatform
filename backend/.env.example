# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (Neon) ─────────────────────────────────────
# 1. Sign in at https://console.neon.tech and open your project.
# 2. Click "Connect" and copy the connection string. It looks like:
#      postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# 3. Paste it below (or just run start.bat, which asks for it).
# SSL is switched on automatically for Neon hosts.
DATABASE_URL=paste_your_neon_connection_string_here

# Only needed for non-Neon hosts that require SSL (leave blank for Neon):
# DATABASE_SSL=true
# DATABASE_SSL_VERIFY=false

# ── Auth ────────────────────────────────────────────────
# start.bat generates this for you. Must be 32+ characters.
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# First admin account, created the first time the database is set up.
ADMIN_EMAIL=admin@willstechstore.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Store Admin

# ── CORS ────────────────────────────────────────────────
# Leave blank: the backend serves the website itself (same origin).
CORS_ORIGIN=
